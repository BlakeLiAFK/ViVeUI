<Window x:Class="ViVeUI.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{Binding L[WindowTitle]}" Width="1440" Height="960" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid x:Name="Root" Background="{DynamicResource CanvasBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,25"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="8,0,0,8"><Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="34" Height="34"><TextBlock Text="V" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ViVeUI" FontWeight="SemiBold" FontSize="22" Margin="9,1,0,0"/></StackPanel><TextBlock Text="{Binding L[AppSubtitle]}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,28"/>
    <Button Style="{StaticResource Navigation}" Tag="{Binding IsExplore}" Click="ExploreClick" AutomationProperties.AutomationId="ExploreNav"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="{Binding L[Explore]}"/></StackPanel></Button>
    <Button Style="{StaticResource Navigation}" Tag="{Binding IsChanges}" Click="ChangesClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="{Binding L[Changes]}"/></StackPanel></Button>
    <Button Style="{StaticResource Navigation}" Tag="{Binding IsUpdates}" Click="UpdatesClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="{Binding L[Updates]}"/></StackPanel></Button>
    <Button Style="{StaticResource Navigation}" Tag="{Binding IsSettings}" Click="SettingsClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,1,12,0"/><TextBlock Text="{Binding L[Settings]}"/></StackPanel></Button>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="8,0"><TextBlock Text="{Binding L[Tagline]}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding VersionText}" Margin="0,16,0,4" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="GPL-3.0-or-later" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="24,23,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18"><TextBlock Text="{Binding ModeText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding BuildText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/></DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="ExplorePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,19"><TextBlock Text="{Binding L[ExploreTitle]}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding L[GalleryHelp]}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,17"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Border Background="{DynamicResource SelectionBrush}" CornerRadius="9" Padding="3"><StackPanel Orientation="Horizontal"><RadioButton Style="{StaticResource Segment}" GroupName="CatalogMode" Content="{Binding L[Curated]}" IsChecked="{Binding IsCurated}"/><RadioButton Style="{StaticResource Segment}" GroupName="CatalogMode" Content="{Binding L[AllIds]}" IsChecked="{Binding ShowAllIds}"/></StackPanel></Border><TextBox x:Name="SearchBox" Grid.Column="2" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding L[Search]}" AutomationProperties.Name="{Binding L[Search]}" AutomationProperties.AutomationId="FeatureSearch"/><TextBlock Grid.Column="2" Text="{Binding L[Search]}" Margin="13,10,0,0" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Visibility="{Binding SearchPlaceholderVisibility}"/></Grid></StackPanel>
     <Grid Grid.Row="1" x:Name="ExplorerColumns"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="20"/><ColumnDefinition Width="324"/></Grid.ColumnDefinitions>
      <Grid x:Name="CatalogPane">
       <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding GalleryVisibility}"><StackPanel><ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Click="CardClick" Tag="{Binding Feature}" Margin="0,0,12,14" Padding="0" HorizontalContentAlignment="Stretch" Background="{DynamicResource PaperBrush}" AutomationProperties.Name="{Binding Title}"><StackPanel><Border Background="#F0F5FD" CornerRadius="10,10,0,0" Height="125"><Image Source="{Binding Image}" Margin="14,9" Stretch="Uniform" AutomationProperties.Name="{Binding Title}"/></Border><StackPanel Margin="16,12,16,14"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Height="38" Margin="0,7,0,9"/><TextBlock Text="{Binding Context}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><DockPanel Margin="0,11,0,0"><TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding DetailLabel}" FontSize="11" HorizontalAlignment="Right"/></DockPanel></StackPanel></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding L[Coverage]}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,8"/><TextBlock Text="{Binding L[CoverageNote]}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,0,12,0"/></StackPanel></ScrollViewer>
       <Grid Visibility="{Binding CatalogVisibility}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="{Binding L[AddId]}" Click="InspectClick" DockPanel.Dock="Right" Margin="10,0,0,0"/><ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Category}" AutomationProperties.Name="{Binding L[All]}"/></DockPanel><Grid Grid.Row="1"><ListBox x:Name="FeatureList" ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" AutomationProperties.Name="{Binding L[All]}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Id, StringFormat=ID {0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding L[Empty]}" Margin="20" Visibility="{Binding EmptyVisibility}" IsHitTestVisible="False"/></Grid><DockPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="{Binding L[OpenDetails]}" Click="OpenDetailClick" DockPanel.Dock="Right" Visibility="{Binding CompactVisibility}"/><TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></DockPanel></Grid>
      </Grid>
      <Border x:Name="DetailPane" Grid.Column="2" Style="{StaticResource Card}" Padding="18"><DockPanel>
       <StackPanel DockPanel.Dock="Top"><Button Content="{Binding L[Back]}" Click="BackClick" Visibility="{Binding CompactVisibility}" Margin="0,0,0,12"/><TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Selected.Id, StringFormat=ID {0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,15"/></StackPanel>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Border Background="{DynamicResource SelectionBrush}" CornerRadius="9" Padding="3"><UniformGrid Columns="3"><RadioButton GroupName="Override" Style="{StaticResource Segment}" Content="{Binding L[Default]}" IsChecked="{Binding IsDefault}" FontSize="11" Padding="3,8"/><RadioButton GroupName="Override" Style="{StaticResource Segment}" Content="{Binding L[Enabled]}" IsChecked="{Binding IsEnabledOverride}" FontSize="11" Padding="3,8"/><RadioButton GroupName="Override" Style="{StaticResource Segment}" Content="{Binding L[Disabled]}" IsChecked="{Binding IsDisabledOverride}" FontSize="11" Padding="3,8"/></UniformGrid></Border><TextBlock Text="{Binding L[DefaultHelp]}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,12"/><Button Content="{Binding L[Stage]}" Style="{StaticResource Primary}" Click="StageClick" AutomationProperties.AutomationId="StageButton"/><Button Content="{Binding L[Source]}" Click="SourceClick" FontSize="11" BorderThickness="0" Padding="4,6" MinHeight="28" Margin="0,6,0,0"/></StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#F0F5FD" CornerRadius="9" Height="140" Visibility="{Binding HistoricalVisibility}"><Image Source="{Binding Illustration}" Margin="12" Stretch="Uniform" AutomationProperties.Name="{Binding IllustrationAlt}"/></Border><TextBlock Text="{Binding IllustrationAlt}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,10"/><TextBlock Text="{Binding SelectedDescription}" FontSize="12"/><TextBlock Text="{Binding L[Observed]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding ObservationText}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding L[UserOverride]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding OverrideText}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding L[Unverified]}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/><Button Content="{Binding L[HistoricalSource]}" Click="HistoricalClick" Visibility="{Binding HistoricalVisibility}" FontSize="11" BorderThickness="0" Padding="3,6" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
      </DockPanel></Border>
     </Grid>
    </Grid>
    <Grid x:Name="ChangesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock Text="{Binding L[ReviewTitle]}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding L[ReviewSubtitle]}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16"/><Border Background="#FFF6E4" BorderBrush="#F2DBAA" BorderThickness="1" CornerRadius="10" Padding="14"><DockPanel><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#9B6418" Margin="0,1,12,0"/><TextBlock Text="{Binding L[BriefWarning]}" Foreground="#79511C" FontSize="12"/></DockPanel></Border></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl ItemsSource="{Binding ReviewRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#F0F5FD" CornerRadius="9" Height="110" VerticalAlignment="Top"><Image Source="{Binding Image}" Margin="10" Stretch="Uniform"/></Border><StackPanel Grid.Column="2"><DockPanel><Button Content="×" Tag="{Binding Id}" Click="RemoveClick" DockPanel.Dock="Right" Padding="4" MinHeight="22" Width="22" BorderThickness="0" AutomationProperties.Name="{Binding DataContext.L[Remove], RelativeSource={RelativeSource AncestorType=Window}}"/><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Id, StringFormat=ID {0}}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,9"/><TextBlock Text="{Binding Description}" FontSize="12"/><TextBlock Text="{Binding Context}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"/><Border Background="{DynamicResource SelectionBrush}" CornerRadius="7" Padding="10,8"><TextBlock FontSize="12"><Run Text="{Binding Before, Mode=OneWay}"/><Run Text="    →    "/><Run Text="{Binding After, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></TextBlock></Border></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Expander Header="{Binding L[History]}" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding L[HistoryHelp]}" FontSize="12" Margin="0,10,0,12"/><ListBox x:Name="HistoryList" ItemsSource="{Binding History}" DisplayMemberPath="Summary" MaxHeight="180" MinHeight="70" AutomationProperties.Name="{Binding L[History]}"/><TextBlock Text="{Binding SelectedItem.Detail, ElementName=HistoryList}" FontSize="12" Margin="0,8"/><Button Content="{Binding L[Undo]}" Click="UndoClick"/></StackPanel></Expander></StackPanel></ScrollViewer>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding L[Summary]}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewCountText}" FontSize="26" FontWeight="SemiBold" Margin="0,18,0,4" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding ReviewIdsText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><Separator Margin="0,18"/><TextBlock Text="{Binding L[StepReview]}" FontWeight="SemiBold"/><TextBlock Text="{Binding L[StepReviewBody]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/><TextBlock Text="{Binding L[StepApprove]}" FontWeight="SemiBold"/><TextBlock Text="{Binding L[StepApproveBody]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/><TextBlock Text="{Binding L[StepRestart]}" FontWeight="SemiBold"/><TextBlock Text="{Binding L[StepRestartBody]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/><CheckBox IsChecked="{Binding Acknowledged}"><TextBlock Text="{Binding L[SafetyAck]}" FontSize="11"/></CheckBox><Button Content="{Binding L[Clear]}" Click="ClearClick" Margin="0,16,0,0" FontSize="12"/></StackPanel></Border>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="{Binding L[UpdateTitle]}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="{Binding L[UpdateHelp]}" Margin="0,14,0,28"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding VersionText}" FontSize="26"/><TextBlock Text="{Binding UpdateText}" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,10"/><ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" Height="5"/><TextBlock Text="{Binding UpdateDetails}" Margin="0,16,0,16"/><WrapPanel><Button Content="{Binding L[Check]}" Click="CheckClick" IsEnabled="{Binding NotBusy}" Style="{StaticResource Primary}"/><Button Content="{Binding L[Download]}" Click="DownloadClick" IsEnabled="{Binding CanDownload}"/><Button Content="{Binding L[OpenDownloads]}" Click="OpenDownloadsClick"/></WrapPanel></StackPanel></Border><CheckBox IsChecked="{Binding AutoCheck}" Margin="0,25,0,15"><TextBlock Text="{Binding L[AutoCheck]}"/></CheckBox><CheckBox IsChecked="{Binding AutoDownload}"><TextBlock Text="{Binding L[AutoDownload]}"/></CheckBox></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="{Binding L[SettingsTitle]}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="{Binding L[Language]}" Style="{StaticResource Label}" Margin="0,30,0,8"/><ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" SelectedIndex="0" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="{Binding L[Language]}"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="简体中文" Tag="zh"/><ComboBoxItem Content="Español" Tag="es"/></ComboBox><TextBlock Text="{Binding L[Scale]}" Style="{StaticResource Label}"/><Slider Minimum="1" Maximum="1.35" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ScaleChanged" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="{Binding L[Scale]}"/><Button Content="{Binding L[Refresh]}" Click="RefreshClick" HorizontalAlignment="Left" Margin="0,22,0,22"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding L[About]}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding L[AboutHelp]}" Margin="0,12,0,18"/><TextBlock Text="3f8c6a3425983412da1e8b26cd757c3aa17b3f25" FontFamily="Consolas" FontSize="12"/><Button Content="{Binding L[Source]}" Click="SourceClick" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,18,0,0"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{Binding L[Back]}" Click="ExploreClick" Visibility="{Binding ReviewVisibility}" Margin="0,0,10,0"/><Button Content="{Binding L[Review]}" Style="{StaticResource Primary}" Click="ChangesClick" Visibility="{Binding BrowseFooterVisibility}"/><Button x:Name="ApplyButton" Content="{Binding L[Apply]}" Style="{StaticResource Primary}" Click="ApplyClick" IsEnabled="{Binding CanApply}" Visibility="{Binding ReviewVisibility}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding QueueText}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" MaxHeight="32" AutomationProperties.LiveSetting="Polite"/></StackPanel></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
