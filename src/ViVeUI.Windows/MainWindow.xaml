<Window x:Class="ViVeUI.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{Binding L[WindowTitle]}" FlowDirection="{Binding L.Direction}" FontFamily="{Binding L.Font}" Language="{Binding L.XmlLanguage}" Width="1440" Height="960" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid x:Name="Root" Language="{Binding L.XmlLanguage}" FlowDirection="{Binding L.Direction}" Background="{DynamicResource CanvasBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,25"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="8,0,0,8"><Border Background="{DynamicResource AccentBrush}" CornerRadius="9" Width="34" Height="34"><TextBlock Text="V" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ViVeUI" FontWeight="SemiBold" FontSize="22" Margin="9,1,0,0"/></StackPanel><TextBlock Text="{Binding L[AppSubtitle]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,28"/>
    <Button x:Name="ExploreNavigation" Style="{StaticResource Navigation}" Tag="{Binding IsExplore}" Click="ExploreClick" AutomationProperties.AutomationId="ExploreNav"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,1,8,0"/><TextBlock Grid.Column="1" Text="{Binding L[Explore]}"/></Grid></Button>
    <Button x:Name="ChangesNavigation" Style="{StaticResource Navigation}" Tag="{Binding IsChanges}" Click="ChangesClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,1,8,0"/><TextBlock Grid.Column="1" Text="{Binding L[Changes]}"/></Grid></Button>
    <Button x:Name="UpdatesNavigation" Style="{StaticResource Navigation}" Tag="{Binding IsUpdates}" Click="UpdatesClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Margin="0,1,8,0"/><TextBlock Grid.Column="1" Text="{Binding L[Updates]}"/></Grid></Button>
    <Button x:Name="SettingsNavigation" Style="{StaticResource Navigation}" Tag="{Binding IsSettings}" Click="SettingsClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,1,8,0"/><TextBlock Grid.Column="1" Text="{Binding L[Settings]}"/></Grid></Button>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="8,0"><TextBlock Text="{Binding L[Language]}" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="SidebarLanguage" ItemsSource="{Binding Languages}" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectedValue="{Binding SelectedValue, ElementName=LanguageBox, Mode=TwoWay}" FontFamily="Global User Interface" FontSize="12" Margin="0,0,0,12"/><TextBlock Text="{Binding L[Appearance]}" FontSize="12" Margin="0,0,0,6"/><ComboBox x:Name="ThemeBox" SelectedIndex="0" SelectionChanged="ThemeChanged" FontSize="12" Margin="0,0,0,18"><ComboBoxItem Content="{Binding L[SystemTheme]}"/><ComboBoxItem Content="{Binding L[LightTheme]}"/><ComboBoxItem Content="{Binding L[DarkTheme]}"/></ComboBox><TextBlock Text="{Binding L[Tagline]}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding VersionText}" Margin="0,16,0,4" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock FlowDirection="LeftToRight" Text="GPL-3.0-or-later" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="56,15,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="ContextHeader" Margin="0,0,0,8" MinHeight="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ModeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Border Background="{DynamicResource PaperBrush}" CornerRadius="12" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding L[CatalogCountChip]}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border><Border Background="{DynamicResource PaperBrush}" CornerRadius="12" Padding="10,5"><TextBlock Text="{Binding BuildText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border></StackPanel></Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="ExplorePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding L[ExploreTitle]}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding L[GalleryHelp]}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><Border Background="{DynamicResource SelectionBrush}" CornerRadius="9" Padding="3"><StackPanel Orientation="Horizontal"><RadioButton Style="{StaticResource CatalogTab}" GroupName="CatalogMode" Content="{Binding L[Curated]}" IsChecked="{Binding IsCurated}"/><RadioButton Style="{StaticResource CatalogTab}" GroupName="CatalogMode" Content="{Binding L[AllIds]}" IsChecked="{Binding ShowAllIds}"/></StackPanel></Border><TextBox x:Name="SearchBox" FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Grid.Column="2" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding L[Search]}" AutomationProperties.Name="{Binding L[Search]}" AutomationProperties.AutomationId="FeatureSearch"/><TextBlock Grid.Column="2" Text="{Binding L[Search]}" Margin="13,10,0,0" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Visibility="{Binding SearchPlaceholderVisibility}"/></Grid></StackPanel>
     <Grid Grid.Row="1" x:Name="ExplorerColumns"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="20"/><ColumnDefinition Width="438"/></Grid.ColumnDefinitions>
      <Grid x:Name="CatalogPane">
       <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" Visibility="{Binding GalleryVisibility}"><StackPanel><ItemsControl x:Name="GalleryItems" ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource FeatureCardButton}" Click="CardClick" Tag="{Binding Feature}" Margin="0,0,12,14" Padding="0" HorizontalContentAlignment="Stretch" Background="{DynamicResource PaperBrush}" AutomationProperties.Name="{Binding Title}"><StackPanel><Border Background="#F0F5FD" CornerRadius="10,10,0,0" Height="155"><Grid><Image FlowDirection="LeftToRight" Source="{Binding Image}" Margin="8,5" Stretch="Uniform" AutomationProperties.Name="{Binding Title}"/><Border Background="{DynamicResource PaperBrush}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8"><TextBlock Text="{Binding HistoryLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border></Grid></Border><StackPanel Margin="14,10,14,12"><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,8"/><Border Background="{DynamicResource SelectionBrush}" CornerRadius="11" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Context}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border><DockPanel Margin="0,11,0,0"><TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding DetailLabel}" FontSize="12" HorizontalAlignment="Right"/></DockPanel></StackPanel></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding L[Coverage]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,8"/><TextBlock Text="{Binding L[CoverageNote]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="2,0,12,0"/></StackPanel></ScrollViewer>
       <Grid Visibility="{Binding CatalogVisibility}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><Button Content="{Binding L[AddId]}" Click="InspectClick" DockPanel.Dock="Right" Margin="10,0,0,0"/><ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Category}" AutomationProperties.Name="{Binding L[All]}"/></DockPanel><Grid Grid.Row="1"><ListBox x:Name="FeatureList" ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" AutomationProperties.Name="{Binding L[All]}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding Id, StringFormat=ID {0}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding L[Empty]}" Margin="20" Visibility="{Binding EmptyVisibility}" IsHitTestVisible="False"/></Grid><DockPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="{Binding L[OpenDetails]}" Click="OpenDetailClick" DockPanel.Dock="Right" Visibility="{Binding CompactVisibility}"/><TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></DockPanel></Grid>
      </Grid>
      <Border x:Name="DetailPane" Grid.Column="2" Style="{StaticResource Card}" Padding="18"><DockPanel>
       <StackPanel DockPanel.Dock="Top"><Button Content="{Binding L[Back]}" Click="BackClick" Visibility="{Binding CompactVisibility}" Margin="0,0,0,12"/><TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding Selected.Id, StringFormat=ID {0}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,15"/></StackPanel>
       <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Border Background="{DynamicResource SelectionBrush}" CornerRadius="9" Padding="3"><UniformGrid Columns="3"><RadioButton GroupName="Override" Style="{StaticResource Segment}" Content="{Binding L[Default]}" IsChecked="{Binding IsDefault}" FontSize="12" Padding="3,8"/><RadioButton GroupName="Override" Style="{StaticResource Segment}" Content="{Binding L[Enabled]}" IsChecked="{Binding IsEnabledOverride}" FontSize="12" Padding="3,8"/><RadioButton GroupName="Override" Style="{StaticResource Segment}" Content="{Binding L[Disabled]}" IsChecked="{Binding IsDisabledOverride}" FontSize="12" Padding="3,8"/></UniformGrid></Border><TextBlock Text="{Binding L[DefaultHelp]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,12"/><Button x:Name="StageAction" Content="{Binding L[Stage]}" Style="{StaticResource Primary}" Click="StageClick" AutomationProperties.AutomationId="StageButton"/><Button Content="{Binding L[Source]}" Click="SourceClick" FontSize="12" BorderThickness="0" Padding="4,6" MinHeight="28" Margin="0,6,0,0"/></StackPanel>
       <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding L[Observed]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBlock x:Name="ObservedValue" Text="{Binding ObservationText}" FontSize="14" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding L[UserOverride]}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><TextBlock x:Name="OverrideValue" Text="{Binding OverrideText}" FontSize="14" FontWeight="SemiBold"/></StackPanel></Grid>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#F0F5FD" CornerRadius="9" Height="230" Visibility="{Binding HistoricalVisibility}"><Image FlowDirection="LeftToRight" Source="{Binding Illustration}" Margin="12" Stretch="Uniform" AutomationProperties.Name="{Binding IllustrationAlt}"/></Border><TextBlock Text="{Binding IllustrationAlt}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,6"/><TextBlock Text="{Binding SelectedDescription}" FontSize="14"/><TextBlock Text="{Binding L[Unverified]}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,12,0,0"/><Button Content="{Binding L[HistoricalSource]}" Click="HistoricalClick" Visibility="{Binding HistoricalVisibility}" FontSize="12" BorderThickness="0" Padding="3,6" HorizontalAlignment="Left"/></StackPanel></ScrollViewer>
      </DockPanel></Border>
     </Grid>
    </Grid>
    <Grid x:Name="ChangesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
     <Grid x:Name="ReviewBody"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding L[ReviewTitle]}" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="{Binding L[ReviewSubtitle]}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18"/><Border Background="#FFF6E4" BorderBrush="#F2DBAA" BorderThickness="1" CornerRadius="10" Padding="14"><DockPanel><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#9B6418" Margin="0,1,12,0"/><TextBlock Text="{Binding L[BriefWarning]}" Foreground="#79511C" FontSize="14"/></DockPanel></Border></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><ItemsControl ItemsSource="{Binding ReviewRows}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16"><StackPanel><Grid MinHeight="145"><Grid.ColumnDefinitions><ColumnDefinition Width="274"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#F0F5FD" CornerRadius="10" Height="155" VerticalAlignment="Top"><Image FlowDirection="LeftToRight" Source="{Binding Image}" Margin="6" Stretch="Uniform"/></Border><StackPanel Grid.Column="2"><DockPanel><Button Content="⧉" Tag="{Binding Id}" Click="CopyIdClick" DockPanel.Dock="Right" Padding="4" MinHeight="24" Width="24" BorderThickness="0" ToolTip="{Binding CopyLabel}"/><Button Content="×" Tag="{Binding Id}" Click="RemoveClick" DockPanel.Dock="Right" Padding="4" MinHeight="24" Width="24" BorderThickness="0" ToolTip="{Binding RemoveLabel}"/><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/></DockPanel><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding Id, StringFormat=ID {0}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,6"/><TextBlock Text="{Binding Description}" FontSize="14"/><Border Background="{DynamicResource SelectionBrush}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock Text="{Binding Context}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border><Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding BeforeLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><Border Background="{DynamicResource CanvasBrush}" CornerRadius="8" Padding="12,9"><TextBlock Text="{Binding Before}" FontSize="14"/></Border></StackPanel><TextBlock Grid.Column="1" FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding DataContext.TransitionArrow, RelativeSource={RelativeSource AncestorType=ItemsControl}}" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="20" Margin="0,0,0,8"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding AfterLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/><Border Background="{DynamicResource SelectionBrush}" CornerRadius="8" Padding="12,9"><TextBlock Text="{Binding After}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></Border></StackPanel></Grid></StackPanel></Grid>
        <Expander Header="{Binding DetailsLabel}" FontSize="12" Margin="0,4,0,0"><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding TechnicalName}" FontFamily="Consolas" Margin="0,8,0,0"/></Expander>
       </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Background="{DynamicResource SelectionBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12"><TextBlock Text="{Binding L[RecoveryReminder]}" FontSize="13"/></Border><Expander Header="{Binding L[History]}" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding L[HistoryHelp]}" FontSize="14" Margin="0,10,0,12"/><ListBox x:Name="HistoryList" ItemsSource="{Binding History}" DisplayMemberPath="Summary" MaxHeight="180" MinHeight="70" AutomationProperties.Name="{Binding L[History]}"/><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding SelectedItem.Detail, ElementName=HistoryList}" FontSize="14" Margin="0,8"/><Button Content="{Binding L[Undo]}" Click="UndoClick"/></StackPanel></Expander></StackPanel></ScrollViewer>
     </Grid>
     <ScrollViewer x:Name="SummaryPane" Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top"><StackPanel><TextBlock Text="{Binding L[Summary]}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewCountText}" FontSize="30" FontWeight="SemiBold" Margin="0,22,0,8" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding ReviewIdsText}" FontSize="14" Foreground="{DynamicResource MutedBrush}"/><Border Background="{DynamicResource CanvasBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,0"><TextBlock Text="{Binding L[RestartRow]}" FontSize="14"/></Border><Separator Margin="0,22"/><TextBlock Text="{Binding L[StepReview]}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding L[StepReviewBody]}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,22"/><TextBlock Text="{Binding L[StepApprove]}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding L[StepApproveBody]}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,22"/><TextBlock Text="{Binding L[StepRestart]}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding L[StepRestartBody]}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,22"/><CheckBox IsChecked="{Binding Acknowledged}"><TextBlock Text="{Binding L[SafetyAck]}" FontSize="13"/></CheckBox><Button Content="{Binding L[Clear]}" Click="ClearClick" Margin="0,20,0,0" FontSize="14"/></StackPanel></Border></ScrollViewer>
    </Grid>
    <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="{Binding L[UpdateTitle]}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="{Binding L[UpdateHelp]}" Margin="0,14,0,28"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding VersionText}" FontSize="26"/><TextBlock Text="{Binding UpdateText}" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,10"/><ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" Height="5"/><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="{Binding UpdateDetails}" Margin="0,16,0,16"/><WrapPanel><Button Content="{Binding L[Check]}" Click="CheckClick" IsEnabled="{Binding NotBusy}" Style="{StaticResource Primary}"/><Button Content="{Binding L[Download]}" Click="DownloadClick" IsEnabled="{Binding CanDownload}"/><Button Content="{Binding L[OpenDownloads]}" Click="OpenDownloadsClick"/></WrapPanel></StackPanel></Border><CheckBox IsChecked="{Binding AutoCheck}" Margin="0,25,0,15"><TextBlock Text="{Binding L[AutoCheck]}"/></CheckBox><CheckBox IsChecked="{Binding AutoDownload}"><TextBlock Text="{Binding L[AutoDownload]}"/></CheckBox></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="{Binding L[SettingsTitle]}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="{Binding L[Language]}" Style="{StaticResource Label}" Margin="0,30,0,8"/><ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectedValue="{Binding LanguagePreference, Mode=TwoWay}" SelectionChanged="LanguageChanged" FontFamily="Global User Interface" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="{Binding L[Language]}"/><TextBlock Text="{Binding L[Scale]}" Style="{StaticResource Label}"/><Slider Minimum="1" Maximum="1.35" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ScaleChanged" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="{Binding L[Scale]}"/><Button Content="{Binding L[Refresh]}" Click="RefreshClick" HorizontalAlignment="Left" Margin="0,22,0,22"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding L[About]}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding L[AboutHelp]}" Margin="0,12,0,18"/><WrapPanel><Button Content="{Binding L[License]}" Click="LicenseClick"/><Button Content="{Binding L[ReleasePage]}" Click="ReleaseClick" Margin="8,0,0,0"/></WrapPanel><TextBlock FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Text="3f8c6a3425983412da1e8b26cd757c3aa17b3f25" FontFamily="Consolas" FontSize="12"/><Button Content="{Binding L[Source]}" Click="SourceClick" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,18,0,0"><DockPanel><Button Content="{Binding L[Back]}" Click="ExploreClick" Visibility="{Binding ReviewVisibility}" Margin="0,0,14,0" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{Binding L[Review]}" Style="{StaticResource Primary}" Click="ChangesClick" Visibility="{Binding BrowseFooterVisibility}"/><Button x:Name="ApplyButton" MaxWidth="260" Content="{Binding L[Apply]}" Style="{StaticResource Primary}" Click="ApplyClick" IsEnabled="{Binding CanApply}" Visibility="{Binding ReviewVisibility}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding QueueText}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" MaxHeight="32" AutomationProperties.LiveSetting="Polite"/><Button Content="{Binding L[TechnicalDetails]}" Visibility="{Binding DiagnosticVisibility}" Click="DiagnosticClick" HorizontalAlignment="Left" FontSize="12" Padding="4,2" MinHeight="24"/></StackPanel></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
