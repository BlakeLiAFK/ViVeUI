<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF><AllowUnsafeBlocks>true</AllowUnsafeBlocks><ApplicationManifest>app.manifest</ApplicationManifest><AssemblyName>ViVeUI</AssemblyName><StartupObject>ViVeUI.Windows.Program</StartupObject><GenerateAssemblyInfo>true</GenerateAssemblyInfo></PropertyGroup><ItemGroup><ProjectReference Include="../ViVeUI.Core/ViVeUI.Core.csproj"/><ProjectReference Include="../ViVeUI.Native/ViVeUI.Native.csproj"/><Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest"/><Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest"/></ItemGroup><Target Name="RecordRuntimePackPaths" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
<Error Condition="'@(ResolvedRuntimePack)' == ''" Text="Runtime packs missing from self-contained publish."/>
<WriteLinesToFile File="$(MSBuildProjectDirectory)/obj/runtime-pack-paths.txt" Lines="@(ResolvedRuntimePack->'%(PackageDirectory)')" Overwrite="true"/>
</Target></Project>
