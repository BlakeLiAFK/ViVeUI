<Window x:Class="ViVeUI.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ViVeUI · Windows feature explorer" Width="1440" Height="960" MinWidth="880" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid x:Name="Root"><Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource InkBrush}" Padding="20,30"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="ViVeUI" FontSize="29" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="FEATURE EXPLORER" FontSize="10" Foreground="#B6C5E0" Margin="0,6,0,34"/>
    <Button Content="{Binding L[Explore]}" Click="ExploreClick" AutomationProperties.AutomationId="ExploreNav"/><Button Content="{Binding L[Changes]}" Click="ChangesClick" AutomationProperties.AutomationId="ChangesNav"/><Button Content="{Binding L[Updates]}" Click="UpdatesClick"/><Button Content="{Binding L[Settings]}" Click="SettingsClick"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="{Binding L[Tagline]}" Foreground="#D8E3F8" FontSize="16" Margin="0,0,0,25"/><TextBlock Text="0.1.0 / GPL-3.0+" Foreground="#B6C5E0" FontSize="11"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,25,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,20"><TextBlock Text="{Binding ModeText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding BuildText}" HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="ExplorePage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="{Binding L[ExploreTitle]}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="{Binding L[ExploreSubtitle]}" Margin="0,8,0,18" Foreground="{DynamicResource MutedBrush}"/><Border Background="{DynamicResource PaperBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,20"><StackPanel><TextBlock Text="{Binding L[Coverage]}" FontWeight="SemiBold"/><TextBlock Text="{Binding L[CoverageNote]}" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border></StackPanel>
     <Grid Grid.Row="1" x:Name="ExplorerColumns"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1.05*" MinWidth="240"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock Text="{Binding L[Search]}" Style="{StaticResource Label}"/><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding L[Search]}" AutomationProperties.AutomationId="FeatureSearch"/></StackPanel>
       <DockPanel Grid.Row="1" Margin="0,8,0,8"><Button Content="{Binding L[AddId]}" Click="InspectClick" DockPanel.Dock="Right" Padding="10,4"/><ComboBox x:Name="CategoryBox" ItemsSource="{Binding Categories}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Category}" AutomationProperties.Name="{Binding L[All]}" Margin="0,4,8,4"/></DockPanel>
       <Grid Grid.Row="2"><ListBox x:Name="FeatureList" ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource LineBrush}" AutomationProperties.Name="{Binding L[All]}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Id, StringFormat=ID {0}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{Binding L[Empty]}" Margin="20" Visibility="{Binding EmptyVisibility}" IsHitTestVisible="False"/></Grid>
       <TextBlock Grid.Row="3" Text="{Binding CountText}" FontSize="12" Margin="0,10,0,4" Foreground="{DynamicResource MutedBrush}"/>
      </Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
       <TextBlock Text="{Binding L[Detail]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
       <TextBlock Text="{Binding Selected.Name}" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,5"/><TextBlock Text="{Binding Selected.Id, StringFormat=ID {0}}" Foreground="{DynamicResource MutedBrush}"/>
       <Border Background="#EDF2FC" CornerRadius="10" Margin="0,18,0,8" Height="150" Visibility="{Binding HistoricalVisibility}"><Viewbox Margin="20"><Canvas Width="330" Height="110" AutomationProperties.Name="{Binding IllustrationAlt}"><Rectangle Width="220" Height="108" RadiusX="8" RadiusY="8" Fill="White" Stroke="#8CA4D6" StrokeThickness="2"/><Rectangle Canvas.Left="12" Canvas.Top="13" Width="60" Height="9" RadiusX="4" RadiusY="4" Fill="#B8C9EE"/><Rectangle Canvas.Left="83" Canvas.Top="13" Width="49" Height="9" RadiusX="4" RadiusY="4" Fill="#E1E8F7"/><Line X1="0" X2="220" Y1="34" Y2="34" Stroke="#D6E0F3"/><Rectangle Canvas.Left="13" Canvas.Top="46" Width="39" Height="46" RadiusX="4" RadiusY="4" Fill="#E1E8F7"/><Rectangle Canvas.Left="64" Canvas.Top="46" Width="64" Height="46" RadiusX="4" RadiusY="4" Fill="#CDDDF8"/><Rectangle Canvas.Left="138" Canvas.Top="46" Width="64" Height="46" RadiusX="4" RadiusY="4" Fill="#E1E8F7"/><Ellipse Canvas.Left="243" Canvas.Top="28" Width="73" Height="73" Fill="#2455D6"/><Path Data="M 261,64 L 272,75 L 296,51" Stroke="White" StrokeThickness="4"/></Canvas></Viewbox></Border>
       <TextBlock Text="{Binding IllustrationAlt}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
       <TextBlock Text="{Binding Description}" Margin="0,12,0,2" FontSize="13"/>
       <TextBlock Text="{Binding L[Observed]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding ObservationText}" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding L[UserOverride]}" Style="{StaticResource Label}"/><TextBlock Text="{Binding OverrideText}" FontWeight="SemiBold"/>
       <ComboBox ItemsSource="{Binding States}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Desired}" AutomationProperties.Name="{Binding L[UserOverride]}" Margin="0,16,0,8"/>
       <TextBlock Text="{Binding L[DefaultHelp]}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
       <Button Content="{Binding L[Stage]}" Style="{StaticResource Primary}" Click="StageClick" Margin="0,15,0,4" AutomationProperties.AutomationId="StageButton"/>
       <WrapPanel><Button Content="{Binding L[Source]}" Click="SourceClick" Padding="8,5" FontSize="12"/><Button Content="{Binding L[HistoricalSource]}" Click="HistoricalClick" Padding="8,5" FontSize="12" Visibility="{Binding HistoricalVisibility}"/></WrapPanel>
      </StackPanel></ScrollViewer></Border>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="ChangesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding L[ReviewTitle]}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="{Binding L[ReviewHelp]}" Margin="0,12,0,20" MaxWidth="850" HorizontalAlignment="Left"/>
     <ItemsControl ItemsSource="{Binding Staged}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Id, StringFormat=ID {0}}" FontSize="12" Margin="0,4,0,8"/><TextBlock><Run Text="{Binding Before.Label}"/><Run Text="  →  "/><Run Text="{Binding After.Label}"/></TextBlock></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <CheckBox x:Name="AcknowledgmentBox" Content="{Binding L[SafetyAck]}" Margin="0,18,0,10" IsChecked="{Binding Acknowledged}"/>
     <WrapPanel><Button x:Name="ApplyButton" Content="{Binding L[Apply]}" Style="{StaticResource Primary}" Click="ApplyClick" IsEnabled="{Binding CanApply}"/><Button Content="{Binding L[Clear]}" Click="ClearClick"/></WrapPanel>
     <TextBlock Text="{Binding L[History]}" FontSize="25" FontWeight="SemiBold" Margin="0,35,0,10"/><TextBlock Text="{Binding L[HistoryHelp]}" Margin="0,0,0,16"/>
     <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" DisplayMemberPath="Summary" MinHeight="90" MaxHeight="230" AutomationProperties.Name="{Binding L[History]}"/><TextBlock Text="{Binding SelectedItem.Detail, ElementName=HistoryList}" Margin="0,10,0,8"/><Button Content="{Binding L[Undo]}" Click="UndoClick" HorizontalAlignment="Left"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="{Binding L[UpdateTitle]}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="{Binding L[UpdateHelp]}" Margin="0,14,0,28"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ViVeUI 0.1.0" FontSize="26"/><TextBlock Text="{Binding UpdateText}" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,10"/><ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="5"/><TextBlock Text="{Binding UpdateDetails}" Margin="0,16,0,16"/><WrapPanel><Button Content="{Binding L[Check]}" Click="CheckClick" IsEnabled="{Binding NotBusy}" Style="{StaticResource Primary}"/><Button Content="{Binding L[Download]}" Click="DownloadClick" IsEnabled="{Binding CanDownload}"/><Button Content="{Binding L[OpenDownloads]}" Click="OpenDownloadsClick"/></WrapPanel></StackPanel></Border><CheckBox Content="{Binding L[AutoCheck]}" IsChecked="{Binding AutoCheck}" Margin="0,25,0,15"/><CheckBox Content="{Binding L[AutoDownload]}" IsChecked="{Binding AutoDownload}"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="780" HorizontalAlignment="Left"><TextBlock Text="{Binding L[SettingsTitle]}" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="{Binding L[Language]}" Style="{StaticResource Label}" Margin="0,30,0,8"/><ComboBox x:Name="LanguageBox" SelectionChanged="LanguageChanged" SelectedIndex="0" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="{Binding L[Language]}"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="简体中文" Tag="zh"/><ComboBoxItem Content="Español" Tag="es"/></ComboBox><TextBlock Text="{Binding L[Scale]}" Style="{StaticResource Label}"/><Slider Minimum="1" Maximum="1.35" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="ScaleChanged" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="{Binding L[Scale]}"/><Button Content="{Binding L[Refresh]}" Click="RefreshClick" HorizontalAlignment="Left" Margin="0,22,0,22"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding L[About]}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding L[AboutHelp]}" Margin="0,12,0,18"/><TextBlock Text="3f8c6a3425983412da1e8b26cd757c3aa17b3f25" FontFamily="Consolas" FontSize="12"/><Button Content="{Binding L[Source]}" Click="SourceClick" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,18,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="{Binding L[Review]}" Style="{StaticResource Primary}" Click="ChangesClick" Margin="14,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding QueueText}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" MaxHeight="48" AutomationProperties.LiveSetting="Polite"/></StackPanel></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
